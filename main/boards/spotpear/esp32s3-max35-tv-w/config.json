{
    "manufacturer": "spotpear",
    "type": "esp32s3-max35-tv-w",
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32s3-max35-tv-w",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": false,
                "display_style": "wechat"
            },
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_LANGUAGE_RU_RU=y",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_CAMERA_GC0308=n",
                "CONFIG_CAMERA_OV5640=y",
                "CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV5640_DVP_YUV422_YUYV_800X600_10FPS=y",
                "CONFIG_CAMERA_OV5640_DVP_DEFAULT_FMT_YUV422_800X600_10FPS=n",
                "CONFIG_CAMERA_OV5640_DVP_DEFAULT_FMT_YUV422_YUYV_800X600_10FPS=y",
                "CONFIG_CAMERA_OV5640_DVP_IF_FORMAT_INDEX_DEFAULT=2",
                "CONFIG_USE_USB_MSC=y",
                "CONFIG_TINYUSB_MSC_ENABLED=y"
            ]
        }
    ]
}
